# Build context is the repo root. Keep it lean and never ship installed
# dependencies or build output — they are recreated inside the image.

# Dependencies and build output (re-created in the image)
web/node_modules
node_modules
web/.next
web/out
web/build

# Local env files — pass secrets at runtime, never bake them into the image
web/.env
web/.env.*
!web/.env.example

# Tests, tooling, and caches not needed for a production build
web/e2e
# Excluded alongside web/e2e, not just as tidiness: tsconfig includes **/*.ts, so
# `next build` type-checks this config inside the image. If it imports anything from
# web/e2e (which is excluded above) the build fails on an unresolvable module. A
# production image has no reason to carry the Playwright config.
web/playwright.config.ts
web/playwright-report
web/test-results
web/coverage
web/.husky
**/*.log
**/.DS_Store

# Top-level content not needed to build the web app
documentation
generated-docs
.claude
*.md

# VCS / CI / IDE
.git
.gitignore
.github
.vscode
.idea

# Docker files themselves
Dockerfile
.dockerignore
